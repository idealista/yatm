[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]

[packages]
# Ansible 8 is ansible-core 2.15, the last release that still accepts the bare
# `include:` directive. All three galaxy roles this project consumes use it, so
# going further would mean changing them. See #51.
ansible = "==8.7.0"
molecule = "==6.0.3"
molecule-plugins = {version = "==23.6.0", extras = ["docker"]}
ansible-lint = "==24.12.2"
docker = "==7.2.0"

[requires]
python_version = "3.10"
