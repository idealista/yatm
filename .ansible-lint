---

# ansible-lint 24 replaced the numeric rule ids this file used to skip (204,
# 303, 503) with named ones, and its default profile is far stricter than 4.2.0
# was. `min` keeps the checks that catch real breakage without turning the
# upgrade into a style rewrite. See #51.
profile: min

exclude_paths:
  - .cache/
  - build/
  - deps/
  - molecule/
  - node_modules/
  - reports/
  - tests/
